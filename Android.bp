package {
    default_applicable_licenses: ["failsafe_license"],
}

license {
    name: "failsafe_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

java_library_host {
    name: "failsafe",
    srcs: ["core/src/main/java/**/*.java"],
    visibility: ["//external/selenium-java:__subpackages__"],
}
